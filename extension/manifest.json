{
  "manifest_version": 3,
  "name": "PagePulse",
  "description": "Ask questions and summarize the current webpage with a local Ollama RAG backend.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/pagepulse-16.png",
    "32": "icons/pagepulse-32.png",
    "48": "icons/pagepulse-48.png",
    "128": "icons/pagepulse-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PagePulse",
    "default_icon": {
      "16": "icons/pagepulse-16.png",
      "32": "icons/pagepulse-32.png",
      "48": "icons/pagepulse-48.png",
      "128": "icons/pagepulse-128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8001/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
